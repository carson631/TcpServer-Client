  <property name="styleSheet">
   <string notr="true">QMainWindow, #centralwidget { background: #f5f6fa; }
QLabel#titleLabel { font-size: 16pt; font-weight: bold; color: #2f54eb; padding: 2px; }
QGroupBox {
  font-weight: bold;
  color: #1d39c4;
  border: 1px solid #d6d9e4;
  border-radius: 8px;
  margin-top: 10px;
  background: #ffffff;
}
QGroupBox::title {
  subcontrol-origin: margin;
  left: 12px;
  padding: 0 4px;
}
QPushButton {
  background: #2f54eb;
  color: #ffffff;
  border: none;
  border-radius: 5px;
  padding: 6px 16px;
  font-weight: bold;
}
QPushButton:hover { background: #4062f5; }
QPushButton:pressed { background: #1d39c4; }
QPushButton:disabled { background: #c3c9e8; color: #f4f5fb; }
QPushButton#deleteUserButton { background: #d4380d; }
QPushButton#deleteUserButton:hover { background: #e64a19; }
QLineEdit, QTextEdit, QListWidget {
  border: 1px solid #d6d9e4;
  border-radius: 5px;
  padding: 3px 5px;
  background: #ffffff;
  selection-background-color: #2f54eb;
}
QLineEdit:focus, QTextEdit:focus, QListWidget:focus { border: 1px solid #2f54eb; }
QListWidget::item { padding: 4px; }
QListWidget::item:selected { background: #e6ebff; color: #1d39c4; }
QTextEdit { font-family: &quot;Microsoft YaHei&quot;; font-size: 10pt; }
QListWidget#userList { font-weight: normal; color: #333333; }</string>
  </property>
  <widget class="QWidget" name="centralwidget">
   <layout class="QVBoxLayout" name="mainLayout" stretch="0,0,1">
    <property name="leftMargin">
     <number>14</number>
    </property>
    <property name="topMargin">
     <number>10</number>
    </property>
    <property name="rightMargin">
     <number>14</number>
    </property>
    <property name="bottomMargin">
     <number>12</number>
    </property>
    <property name="spacing">
     <number>10</number>
    </property>
    <item>
     <widget class="QLabel" name="titleLabel">
      <property name="text">
       <string>TCP 服务器管理控制台</string>
      </property>
      <property name="alignment">
       <set>Qt::AlignCenter</set>
      </property>
     </widget>
    </item>
    <item>
     <layout class="QHBoxLayout" name="statusRow" stretch="1,1">
      <property name="spacing">
       <number>10</number>
      </property>
      <item>
       <widget class="QGroupBox" name="clientGroup">
        <property name="title">
         <string>在线客户端（IP:端口）</string>
        </property>
        <layout class="QVBoxLayout" name="clientLayout">
         <item>
          <widget class="QTextEdit" name="clientsTextEdit">
           <property name="minimumSize">
            <size>
             <width>0</width>
             <height>110</height>
            </size>
           </property>
           <property name="readOnly">
            <bool>true</bool>
           </property>
           <property name="placeholderText">
            <string>暂无客户端连接</string>
           </property>
          </widget>
         </item>
        </layout>
       </widget>
      </item>
      <item>
       <widget class="QGroupBox" name="userGroup">
        <property name="title">
         <string>登录用户（用户名 IP:端口）</string>
        </property>
        <layout class="QVBoxLayout" name="userLayout">
         <item>
          <widget class="QTextEdit" name="usersTextEdit">
           <property name="minimumSize">
            <size>
             <width>0</width>
             <height>110</height>
            </size>
           </property>
           <property name="readOnly">
            <bool>true</bool>
           </property>
           <property name="placeholderText">
            <string>暂无用户登录</string>
           </property>
          </widget>
         </item>
        </layout>
       </widget>
      </item>
     </layout>
    </item>
    <item>
     <layout class="QHBoxLayout" name="bottomRow" stretch="2,1">
      <property name="spacing">
       <number>10</number>
      </property>
      <item>
       <widget class="QGroupBox" name="msgGroup">
        <property name="title">
         <string>消息记录（所有用户发出的消息）</string>
