  <property name="styleSheet">
   <string notr="true">QMainWindow, #centralwidget { background: #f5f6fa; }
QLabel#titleLabel { font-size: 16pt; font-weight: bold; color: #2f54eb; padding: 2px; }
QGroupBox {
  font-weight: bold;
  color: #1d39c4;
  border: 1px solid #d6d9e4;
  border-radius: 8px;
  margin-top: 10px;
  background: #ffffff;
}
QGroupBox::title {
  subcontrol-origin: margin;
  left: 12px;
  padding: 0 4px;
}
QPushButton {
  background: #2f54eb;
  color: #ffffff;
  border: none;
  border-radius: 5px;
  padding: 6px 16px;
  font-weight: bold;
}
QPushButton:hover { background: #4062f5; }
QPushButton:pressed { background: #1d39c4; }
QPushButton:disabled { background: #c3c9e8; color: #f4f5fb; }
QPushButton#deleteUserButton { background: #d4380d; }
QPushButton#deleteUserButton:hover { background: #e64a19; }
QPushButton#queryUserButton { background: #13a8a8; }
QPushButton#queryUserButton:hover { background: #19bcbc; }
QLineEdit, QTextEdit, QSpinBox {
  border: 1px solid #d6d9e4;
  border-radius: 5px;
  padding: 4px 6px;
  background: #ffffff;
  selection-background-color: #2f54eb;
}
QLineEdit:focus, QTextEdit:focus, QSpinBox:focus { border: 1px solid #2f54eb; }
QLineEdit[readOnly="true"] { background: #f0f2f7; }
QTextEdit { font-family: &quot;Microsoft YaHei&quot;, &quot;Consolas&quot;; font-size: 10pt; }
QTableView {
  border: 1px solid #d6d9e4;
  border-radius: 6px;
  background: #ffffff;
  gridline-color: #eef0f5;
  selection-background-color: #e6ebff;
  selection-color: #1d39c4;
}
QTableView::item { padding: 4px 6px; }
QHeaderView::section {
  background: #f0f3fb;
  color: #1d39c4;
  border: none;
  border-right: 1px solid #e2e6f0;
  border-bottom: 1px solid #d6d9e4;
  padding: 6px 6px;
  font-weight: bold;
}
QLabel#dbStatusLabel { color: #8c8c8c; }
QLabel#statsLabel { color: #595959; }</string>
  </property>
  <widget class="QWidget" name="centralwidget">
   <layout class="QVBoxLayout" name="mainLayout" stretch="0,0,0,1">
    <property name="leftMargin">
     <number>14</number>
    </property>
    <property name="topMargin">
     <number>10</number>
    </property>
    <property name="rightMargin">
     <number>14</number>
    </property>
    <property name="bottomMargin">
     <number>12</number>
    </property>
    <property name="spacing">
     <number>10</number>
    </property>
    <item>
     <widget class="QLabel" name="titleLabel">
      <property name="text">
       <string>TCP 服务器管理控制台</string>
      </property>
      <property name="alignment">
       <set>Qt::AlignCenter</set>
      </property>
     </widget>
    </item>
    <item>
     <widget class="QGroupBox" name="dbGroup">
      <property name="title">
       <string>数据库（MySQL）</string>
      </property>
      <layout class="QGridLayout" name="dbGrid" columnstretch="0,1,0,0,0,1">
       <property name="horizontalSpacing">
        <number>8</number>
       </property>
       <property name="verticalSpacing">
        <number>6</number>
       </property>
       <item row="0" column="0">
        <widget class="QLabel" name="dbHostLabel">
         <property name="text">
          <string>主机：</string>
         </property>
        </widget>
       </item>
       <item row="0" column="1">
        <widget class="QLineEdit" name="dbHostEdit">
         <property name="text">
          <string>192.168.5.50</string>
         </property>
         <property name="placeholderText">
          <string>MySQL 服务器 IP</string>
         </property>
        </widget>
       </item>
       <item row="0" column="2">
        <widget class="QLabel" name="dbPortLabel">
