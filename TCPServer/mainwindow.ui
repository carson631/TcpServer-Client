      </item>
     </layout>
    </item>
    <item>
     <layout class="QHBoxLayout" name="bottomRow" stretch="2,1">
      <property name="spacing">
       <number>10</number>
      </property>
      <item>
       <widget class="QGroupBox" name="msgGroup">
        <property name="title">
         <string>消息记录（同时写入 MySQL messages 表）</string>
        </property>
        <layout class="QVBoxLayout" name="msgLayout">
         <item>
          <widget class="QTextEdit" name="msgLineEdit">
