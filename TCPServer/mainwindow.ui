        <layout class="QVBoxLayout" name="manageLayout" stretch="0,0,1,0">
         <property name="spacing">
          <number>8</number>
         </property>
         <item>
          <layout class="QGridLayout" name="manageGrid" columnstretch="0,1">
           <property name="horizontalSpacing">
            <number>8</number>
           </property>
           <property name="verticalSpacing">
            <number>8</number>
           </property>
           <item row="0" column="0">
