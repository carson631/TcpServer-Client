  <property name="styleSheet">
   <string notr="true">QMainWindow, #centralwidget { background: #f5f6fa; }
QLabel#label_3 { font-size: 16pt; font-weight: bold; color: #2f54eb; padding: 2px; }
QGroupBox {
  font-weight: bold;
  color: #1d39c4;
  border: 1px solid #d6d9e4;
  border-radius: 8px;
  margin-top: 10px;
  background: #ffffff;
}
QGroupBox::title {
  subcontrol-origin: margin;
  left: 12px;
  padding: 0 4px;
}
QPushButton {
  background: #2f54eb;
  color: #ffffff;
  border: none;
  border-radius: 5px;
  padding: 6px 16px;
  font-weight: bold;
}
QPushButton:hover { background: #4062f5; }
QPushButton:pressed { background: #1d39c4; }
QPushButton:disabled { background: #c3c9e8; color: #f4f5fb; }
QLineEdit, QTextEdit, QListWidget {
  border: 1px solid #d6d9e4;
  border-radius: 5px;
  padding: 3px 5px;
  background: #ffffff;
  selection-background-color: #2f54eb;
}
QLineEdit:focus, QTextEdit:focus, QListWidget:focus { border: 1px solid #2f54eb; }
QListWidget::item { padding: 4px; }
QListWidget::item:selected { background: #e6ebff; color: #1d39c4; }
QTextEdit { font-family: &quot;Microsoft YaHei&quot;; font-size: 10pt; }</string>
